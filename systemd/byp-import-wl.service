[Unit]
Description=Import remaining Watch Later to YouTube playlist (daily)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Template for a personal tool: point at the installed `byp` entry point and set
# the target playlist via env instead of hardcoding absolute paths in the script.
WorkingDirectory=%h/projects/better-yt-playlist
Environment=BYP_TARGET_PLAYLIST=PLH8xUbQjtTPc
# Dedupe first so the import has room under YouTube's 5,000-item cap; it is a
# cheap no-op (one listing) once the playlist has no duplicates left.
ExecStart=%h/projects/better-yt-playlist/.venv/bin/byp dedupe
ExecStart=%h/projects/better-yt-playlist/.venv/bin/byp import-wl-to-yt
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800

[Install]
WantedBy=default.target
